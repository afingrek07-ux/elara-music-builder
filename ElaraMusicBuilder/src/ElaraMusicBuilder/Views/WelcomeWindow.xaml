<Window x:Class="ElaraMusicBuilder.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}">
    <Border Margin="20" Background="{StaticResource SurfaceBrush}" CornerRadius="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="36,30">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.18" Color="#25305A"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Image Source="/Assets/logo48.png" Width="40" Height="40" Margin="0,0,14,0"/>
                <TextBlock FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="Добро пожаловать в "/><Run Text="Elara Music Builder" Foreground="{StaticResource VioletBrush}"/>
                </TextBlock>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" FontSize="15" Margin="0,4,0,22"
                       Text="Программа превращает вашу музыку в длинное видео для YouTube: с фоном, эквалайзером, треклистом и точными тайм-кодами. Всего пять шагов:"/>

            <ItemsControl>
                <ItemsControl.Resources>
                    <Style TargetType="Border" x:Key="StepRow">
                        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ItemsControl.Resources>
                <Border Style="{StaticResource StepRow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource VioletBrush}"><TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Добавьте музыку" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Перетащите песни в окно. Порядок и названия можно менять." Style="{StaticResource Hint}"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepRow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource VioletBrush}"><TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Выберите фон" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Обложка, фото или короткое видео — оно зациклится само." Style="{StaticResource Hint}"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepRow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource VioletBrush}"><TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Настройте эквалайзер" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Пять стилей, которые двигаются в такт музыке." Style="{StaticResource Hint}"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepRow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource VioletBrush}"><TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Добавьте название и треклист" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Текущая песня подсвечивается автоматически." Style="{StaticResource Hint}"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StepRow}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource TurquoiseBrush}"><TextBlock Text="5" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="14,0,0,0"><TextBlock Text="Создайте видео" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Сначала тест на 20 секунд, затем полное видео и описание для YouTube." Style="{StaticResource Hint}"/></StackPanel>
                    </StackPanel>
                </Border>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Открыть демо-проект" Click="Demo_Click" Margin="0,0,10,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Начать работу" Click="Start_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
