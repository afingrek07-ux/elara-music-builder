<Window x:Class="ElaraMusicBuilder.Views.ThumbnailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ElaraMusicBuilder.Views"
        Title="Обложка для YouTube — 1280 × 720" Width="1320" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}" Icon="/Assets/app.ico" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Холст -->
        <Border Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Перетаскивайте надписи, фото и логотип мышью прямо на обложке." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True" Background="#222">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="Art" Width="1280" Height="720" ClipToBounds="True" Background="#1E1B26">
                            <Rectangle x:Name="BgRect" Width="1280" Height="720"/>
                            <Image x:Name="Photo" Stretch="UniformToFill" Width="1280" Height="720" Cursor="SizeAll"
                                   MouseLeftButtonDown="Element_MouseDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseUp"/>
                            <Rectangle x:Name="Shade" Width="1280" Height="720" IsHitTestVisible="False"/>
                            <TextBlock x:Name="TitleText" Canvas.Left="70" Canvas.Top="380" FontSize="92" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="1100"
                                       Cursor="SizeAll" MouseLeftButtonDown="Element_MouseDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseUp">
                                <TextBlock.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.6" Color="Black"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock x:Name="SubText" Canvas.Left="74" Canvas.Top="300" FontSize="44" FontWeight="SemiBold" Cursor="SizeAll"
                                       MouseLeftButtonDown="Element_MouseDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseUp">
                                <TextBlock.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/></TextBlock.Effect>
                            </TextBlock>
                            <Image x:Name="LogoImg" Canvas.Left="1110" Canvas.Top="40" Width="130" Cursor="SizeAll"
                                   MouseLeftButtonDown="Element_MouseDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseUp"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Сохранить JPEG" Click="SaveJpg_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить PNG" Click="SavePng_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Настройки -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Шаблон" Style="{StaticResource H2}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Тёмный готик" Tag="dark" Click="Template_Click" Margin="0,0,8,8"/>
                            <Button Content="Светлый минимал" Tag="light" Click="Template_Click" Margin="0,0,0,8"/>
                            <Button Content="Неон" Tag="neon" Click="Template_Click" Margin="0,0,8,8"/>
                            <Button Content="Кино" Tag="cinema" Click="Template_Click" Margin="0,0,0,8"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Изображение" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <Button Content="Загрузить фото…" Click="LoadPhoto_Click" Margin="0,0,8,8"/>
                            <Button Content="Убрать" Click="RemovePhoto_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <v:SliderRow x:Name="PhotoScale" Label="Масштаб фото" Minimum="0.5" Maximum="2.5" Step="0.05" Multiplier="100" Suffix=" %" Value="1"/>
                        <TextBlock Text="Цвета фона и градиента" Style="{StaticResource Hint}" Margin="0,6,0,6"/>
                        <WrapPanel>
                            <Button Content="Цвет 1…" Tag="c1" Click="PickBg_Click" Margin="0,0,8,8"/>
                            <Button Content="Цвет 2…" Tag="c2" Click="PickBg_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <CheckBox x:Name="GradientCheck" Content="Затемняющий градиент поверх фото" IsChecked="True" Checked="Changed" Unchecked="Changed"/>
                        <v:SliderRow x:Name="ShadeStrength" Label="Сила градиента" Minimum="0" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="0.75"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Текст" Style="{StaticResource H2}"/>
                        <TextBlock Text="Заголовок" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TitleBox" TextChanged="Changed" AcceptsReturn="True" TextWrapping="Wrap"/>
                        <TextBlock Text="Подзаголовок" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                        <TextBox x:Name="SubBox" TextChanged="Changed"/>
                        <TextBlock Text="Шрифт" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                        <ComboBox x:Name="FontBox" SelectionChanged="Changed"/>
                        <v:SliderRow x:Name="TitleSize" Label="Размер заголовка" Minimum="30" Maximum="200" Step="2" Suffix=" px" Value="92" Margin="0,10,0,0"/>
                        <v:SliderRow x:Name="SubSize" Label="Размер подзаголовка" Minimum="16" Maximum="120" Step="2" Suffix=" px" Value="44"/>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Цвет заголовка…" Tag="title" Click="PickText_Click" Margin="0,0,8,8"/>
                            <Button Content="Цвет подзаголовка…" Tag="sub" Click="PickText_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Логотип" Style="{StaticResource H2}"/>
                        <WrapPanel>
                            <Button Content="Загрузить логотип…" Click="LoadLogo_Click" Margin="0,0,8,8"/>
                            <Button Content="Убрать" Click="RemoveLogo_Click" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <v:SliderRow x:Name="LogoSize" Label="Размер" Minimum="40" Maximum="500" Step="5" Suffix=" px" Value="130"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
