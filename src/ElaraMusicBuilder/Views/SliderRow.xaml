<UserControl x:Class="ElaraMusicBuilder.Views.SliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Grid x:Name="LayoutRoot" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" TextWrapping="Wrap"
                   ToolTip="{Binding Hint}"/>
        <Slider Grid.Column="1" Margin="8,0"
                Minimum="{Binding Minimum}"
                Maximum="{Binding Maximum}"
                SmallChange="{Binding Step}"
                LargeChange="{Binding Step}"
                TickFrequency="{Binding Step}"
                Value="{Binding Value, Mode=TwoWay}"
                ToolTip="{Binding Hint}"/>
        <TextBlock Grid.Column="2" Text="{Binding DisplayText}" HorizontalAlignment="Right"
                   Foreground="{StaticResource Text2Brush}" FontSize="13" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
