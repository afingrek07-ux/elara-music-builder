<Window x:Class="ElaraMusicBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ElaraMusicBuilder.Views"
        xmlns:m="clr-namespace:ElaraMusicBuilder.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Elara Music Builder"
        Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextBrush}"
        Icon="/Assets/app.ico"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Пунктирная зона перетаскивания -->
        <Style x:Key="DropZone" TargetType="Grid">
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="130"/>
            <Setter Property="Margin" Value="0,4,0,18"/>
        </Style>
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="ring" Stroke="{StaticResource BorderBrush}" StrokeThickness="2"/>
                            <Ellipse Margin="4" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource HexBrush}}"
                                     Stroke="#22000000" StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource VioletBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrackItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="4,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource PanelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ObjectDataProvider x:Key="PlaceTargets" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="m:PlaceTarget"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= ШАПКА ================= -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/logo48.png" Width="34" Height="34"/>
                    <Rectangle Width="1.5" Height="26" Fill="#C9CEDA" Margin="14,0"/>
                    <TextBlock FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="ELARA " Foreground="{StaticResource TextBrush}"/><Run Text="MUSIC " Foreground="{StaticResource VioletBrush}"/><Run Text="BUILDER" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" WindowChrome.IsHitTestVisibleInChrome="True"
                                 IsChecked="{Binding Page, Converter={StaticResource IntBool}, ConverterParameter=0}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Создание видео"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" WindowChrome.IsHitTestVisibleInChrome="True"
                                 IsChecked="{Binding Page, Converter={StaticResource IntBool}, ConverterParameter=1}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Проекты"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" GroupName="nav" WindowChrome.IsHitTestVisibleInChrome="True"
                                 IsChecked="{Binding Page, Converter={StaticResource IntBool}, ConverterParameter=2}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Настройки"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectTitle}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="Minimize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
                    <Button Style="{StaticResource WindowButton}" x:Name="MaxButton" Content="&#xE922;" Click="Maximize_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Развернуть"/>
                    <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= СТРАНИЦА: СОЗДАНИЕ ВИДЕО ================= -->
        <Grid Grid.Row="1" Margin="24,20,24,20" Visibility="{Binding Page, Converter={StaticResource IntVis}, ConverterParameter=0}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: шаги -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid Columns="5">
                    <RadioButton Style="{StaticResource StepTab}" Tag="1" Content="Музыка" GroupName="step"
                                 IsChecked="{Binding Step, Converter={StaticResource IntBool}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource StepTab}" Tag="2" Content="Фон" GroupName="step"
                                 IsChecked="{Binding Step, Converter={StaticResource IntBool}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource StepTab}" Tag="3" Content="Эквалайзер" GroupName="step"
                                 IsChecked="{Binding Step, Converter={StaticResource IntBool}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource StepTab}" Tag="4" Content="Оформление" GroupName="step"
                                 IsChecked="{Binding Step, Converter={StaticResource IntBool}, ConverterParameter=4}"/>
                    <RadioButton Style="{StaticResource StepTab}" Tag="5" Content="Видео" GroupName="step"
                                 IsChecked="{Binding Step, Converter={StaticResource IntBool}, ConverterParameter=5}"/>
                </UniformGrid>

                <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <StackPanel Margin="0,0,10,8">

                        <!-- ===== ШАГ 1. МУЗЫКА ===== -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding Step, Converter={StaticResource IntVis}, ConverterParameter=1}">
                            <StackPanel>
                                <TextBlock Text="Загрузите музыку" Style="{StaticResource H1}"/>
                                <TextBlock Text="Добавьте песни в формате MP3, WAV, FLAC или M4A. Исходные файлы не изменяются." Style="{StaticResource Hint}" Margin="0,4,0,14"/>

                                <Grid Style="{StaticResource DropZone}" Drop="AudioDrop" DragOver="FileDragOver" MouseLeftButtonUp="AddTracks_Click">
                                    <Rectangle RadiusX="14" RadiusY="14" Stroke="#9F94EE" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{StaticResource DropZoneBrush}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                        <Border Width="52" Height="52" CornerRadius="14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Перетащите песни сюда или нажмите для выбора" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Поддерживаются: MP3, WAV, FLAC, M4A · до 30 и более треков" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Переходы между песнями" Style="{StaticResource H2}"/>
                                <UniformGrid Columns="2">
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="tr" IsChecked="{Binding Project.Audio.Transition, Converter={StaticResource EnumBool}, ConverterParameter=None}">
                                        <StackPanel><TextBlock Text="Без перехода" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Песни идут друг за другом" Style="{StaticResource Hint}"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="tr" IsChecked="{Binding Project.Audio.Transition, Converter={StaticResource EnumBool}, ConverterParameter=Silence}">
                                        <StackPanel><TextBlock Text="Короткая пауза" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Тишина между песнями" Style="{StaticResource Hint}"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="tr" IsChecked="{Binding Project.Audio.Transition, Converter={StaticResource EnumBool}, ConverterParameter=FadeInOut}">
                                        <StackPanel><TextBlock Text="Fade In / Fade Out" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Каждая песня плавно появляется и затихает" Style="{StaticResource Hint}"/></StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="tr" IsChecked="{Binding Project.Audio.Transition, Converter={StaticResource EnumBool}, ConverterParameter=Crossfade}">
                                        <StackPanel><TextBlock Text="Crossfade" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Песни плавно перетекают одна в другую" Style="{StaticResource Hint}"/></StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <v:SliderRow Label="Длина паузы" Minimum="0" Maximum="10" Step="0.5" Decimals="1" Suffix=" с" Value="{Binding Project.Audio.GapSeconds}"
                                             Visibility="{Binding Project.Audio.Transition, Converter={StaticResource EnumVis}, ConverterParameter=Silence}"/>
                                <v:SliderRow Label="Длина кроссфейда" Minimum="0" Maximum="10" Step="0.5" Decimals="1" Suffix=" с" Value="{Binding Project.Audio.CrossfadeSeconds}"
                                             Hint="Не может быть длиннее половины самой короткой из двух соседних песен"
                                             Visibility="{Binding Project.Audio.Transition, Converter={StaticResource EnumVis}, ConverterParameter=Crossfade}"/>
                                <v:SliderRow Label="Длина затухания" Minimum="0" Maximum="10" Step="0.5" Decimals="1" Suffix=" с" Value="{Binding Project.Audio.TrackFadeSeconds}"
                                             Visibility="{Binding Project.Audio.Transition, Converter={StaticResource EnumVis}, ConverterParameter=FadeInOut}"/>

                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <CheckBox Content="Плавное начало альбома" IsChecked="{Binding Project.Audio.AlbumFadeIn}"/>
                                        <v:SliderRow Label="Длительность" Minimum="0" Maximum="15" Step="0.5" Decimals="1" Suffix=" с" Value="{Binding Project.Audio.AlbumFadeInSeconds}"
                                                     IsEnabled="{Binding Project.Audio.AlbumFadeIn}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <CheckBox Content="Плавный конец альбома" IsChecked="{Binding Project.Audio.AlbumFadeOut}"/>
                                        <v:SliderRow Label="Длительность" Minimum="0" Maximum="20" Step="0.5" Decimals="1" Suffix=" с" Value="{Binding Project.Audio.AlbumFadeOutSeconds}"
                                                     IsEnabled="{Binding Project.Audio.AlbumFadeOut}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Громкость" Style="{StaticResource H2}" Margin="0,10,0,10"/>
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="loud" Content="YouTube (−14 LUFS)"
                                                 IsChecked="{Binding Project.Audio.Loudness, Converter={StaticResource EnumBool}, ConverterParameter=YouTube}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="loud" Content="Мягкое звучание (−16 LUFS)"
                                                 IsChecked="{Binding Project.Audio.Loudness, Converter={StaticResource EnumBool}, ConverterParameter=Soft}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="loud" Content="Без обработки"
                                                 IsChecked="{Binding Project.Audio.Loudness, Converter={StaticResource EnumBool}, ConverterParameter=None}"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,16"
                                           Text="Выравнивание громкости выполняется в два прохода (EBU R128) и не допускает перегруза. «Без обработки» оставляет звук как есть — только защищает от клиппинга на переходах."/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Тайм-коды YouTube" Style="{StaticResource H2}" Margin="0"/>
                                    <TextBlock Text="{Binding TotalText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBox Text="{Binding TimestampsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" Height="170" FontFamily="Consolas, Segoe UI"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,10"
                                           Text="Время рассчитано по точной длине каждой песни с учётом пауз и кроссфейда — оно совпадёт с итоговым видео."/>
                                <WrapPanel>
                                    <Button Content="Скопировать тайм-коды" Click="CopyTimestamps_Click" Margin="0,0,10,8"/>
                                    <Button Content="Сохранить TXT" Click="SaveTimestamps_Click" Margin="0,0,10,8"/>
                                    <Button Content="Сохранить альбом MP3" Click="ExportAlbumMp3_Click" Margin="0,0,10,8" IsEnabled="{Binding IsIdle}"/>
                                    <Button Content="Сохранить альбом WAV" Click="ExportAlbumWav_Click" Margin="0,0,10,8" IsEnabled="{Binding IsIdle}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- ===== ШАГ 2. ФОН ===== -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding Step, Converter={StaticResource IntVis}, ConverterParameter=2}">
                            <StackPanel>
                                <TextBlock Text="Выберите фон" Style="{StaticResource H1}"/>
                                <TextBlock Text="Обложка альбома, фотография или короткое видео (в том числе из Kling AI). Фон автоматически продлевается на всю длину музыки." Style="{StaticResource Hint}" Margin="0,4,0,14"/>

                                <Grid Style="{StaticResource DropZone}" Drop="BackgroundDrop" DragOver="FileDragOver" MouseLeftButtonUp="ChooseBackground_Click">
                                    <Rectangle RadiusX="14" RadiusY="14" Stroke="#9F94EE" StrokeThickness="1.5" StrokeDashArray="5 4" Fill="{StaticResource DropZoneBrush}"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
                                        <Border Width="52" Height="52" CornerRadius="14" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{StaticResource VioletBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Перетащите изображение или видео сюда" FontSize="16" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                                        <TextBlock Text="JPG, PNG, WEBP, MP4, MOV" Style="{StaticResource Hint}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,18">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Project.Background.FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                            <TextBlock Text="{Binding BackgroundInfo}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                        <Button Content="Убрать фон" HorizontalAlignment="Right" Click="RemoveBackground_Click" MinHeight="34" Padding="12,5"/>
                                    </Grid>
                                </Border>

                                <!-- Видео: режим зацикливания -->
                                <StackPanel Visibility="{Binding Project.Background.IsVideo, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Режим зацикливания видео" Style="{StaticResource H2}"/>
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="loop" IsChecked="{Binding Project.Background.LoopMode, Converter={StaticResource EnumBool}, ConverterParameter=Normal}">
                                            <StackPanel><TextBlock Text="Обычное повторение" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Видео начинается заново после окончания" Style="{StaticResource Hint}"/></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="loop" IsChecked="{Binding Project.Background.LoopMode, Converter={StaticResource EnumBool}, ConverterParameter=PingPong}">
                                            <StackPanel><TextBlock Text="Вперёд-назад" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Прямой ход, затем обратный — без скачка" Style="{StaticResource Hint}"/></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="loop" IsChecked="{Binding Project.Background.LoopMode, Converter={StaticResource EnumBool}, ConverterParameter=Crossfade}">
                                            <StackPanel><TextBlock Text="Плавная склейка" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Конец растворяется в начале" Style="{StaticResource Hint}"/></StackPanel>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="loop" IsChecked="{Binding Project.Background.LoopMode, Converter={StaticResource EnumBool}, ConverterParameter=Smart}">
                                            <StackPanel><TextBlock Text="Умное зацикливание" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Ищет самый похожий на начало кадр и склеивает там" Style="{StaticResource Hint}"/></StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                               Text="Умное зацикливание анализирует кадры видео и выбирает лучшую точку склейки. Идеально бесшовный результат зависит от самого ролика и не гарантирован."/>
                                </StackPanel>

                                <!-- Фото: движение -->
                                <StackPanel Visibility="{Binding Project.Background.IsVideo, Converter={StaticResource InvBoolVis}}">
                                    <TextBlock Text="Движение изображения" Style="{StaticResource H2}"/>
                                    <UniformGrid Columns="3">
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Без движения" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=None}"/>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Медленное приближение" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=ZoomIn}"/>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Медленное отдаление" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=ZoomOut}"/>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Панорама влево" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=PanLeft}"/>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Панорама вправо" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=PanRight}"/>
                                        <RadioButton Style="{StaticResource OptionCard}" GroupName="mot" Content="Мягкое парение" IsChecked="{Binding Project.Background.Motion, Converter={StaticResource EnumBool}, ConverterParameter=Float}"/>
                                    </UniformGrid>
                                    <v:SliderRow Label="Скорость движения" Minimum="15" Maximum="180" Step="5" Suffix=" с/цикл" Value="{Binding Project.Background.MotionPeriod}"
                                                 Hint="Сколько секунд длится один плавный цикл движения. Больше — медленнее и спокойнее."/>
                                </StackPanel>

                                <TextBlock Text="Атмосфера" Style="{StaticResource H2}" Margin="0,10,0,10"/>
                                <CheckBox Content="Мерцание света (как от свечи)" IsChecked="{Binding Project.Background.Flicker}"/>
                                <CheckBox Content="Атмосферные частицы (медленно плывущие искры)" IsChecked="{Binding Project.Background.Particles}"/>
                                <v:SliderRow Label="Затемнение фона" Minimum="0" Maximum="0.6" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Background.Dim}"
                                             Hint="Немного затемнённый фон делает текст и эквалайзер заметнее"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== ШАГ 3. ЭКВАЛАЙЗЕР ===== -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding Step, Converter={StaticResource IntVis}, ConverterParameter=3}">
                            <StackPanel>
                                <TextBlock Text="Выберите эквалайзер" Style="{StaticResource H1}"/>
                                <TextBlock Text="Все стили реагируют на настоящую музыку — это анализ звука, а не случайная анимация." Style="{StaticResource Hint}" Margin="0,4,0,14"/>
                                <CheckBox Content="Показывать эквалайзер" IsChecked="{Binding Project.Visualizer.Enabled}"/>

                                <UniformGrid Columns="5" Margin="0,6,0,6" IsEnabled="{Binding Project.Visualizer.Enabled}">
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="viz" IsChecked="{Binding Project.Visualizer.Style, Converter={StaticResource EnumBool}, ConverterParameter=LaserWave}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="M0,20 C8,0 16,0 24,20 S40,40 48,20 S64,0 72,20" Stroke="{StaticResource CoralBrush}" StrokeThickness="3" Height="40" Width="72" Stretch="Uniform" Margin="0,4"/>
                                            <TextBlock Text="Лазерная волна" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="viz" IsChecked="{Binding Project.Visualizer.Style, Converter={StaticResource EnumBool}, ConverterParameter=SpectrumBars}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="M0,40 V24 H6 V40 Z M10,40 V10 H16 V40 Z M20,40 V18 H26 V40 Z M30,40 V4 H36 V40 Z M40,40 V22 H46 V40 Z M50,40 V14 H56 V40 Z M60,40 V28 H66 V40 Z" Fill="{StaticResource VioletBrush}" Height="40" Width="72" Stretch="Uniform" Margin="0,4"/>
                                            <TextBlock Text="Полосы спектра" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="viz" IsChecked="{Binding Project.Visualizer.Style, Converter={StaticResource EnumBool}, ConverterParameter=SpectralLine}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="M0,38 L8,30 L14,10 L20,26 L28,18 L36,28 L44,8 L52,24 L60,30 L72,36" Stroke="{StaticResource TurquoiseBrush}" StrokeThickness="3" Height="40" Width="72" Stretch="Uniform" Margin="0,4"/>
                                            <TextBlock Text="Спектральная линия" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="viz" IsChecked="{Binding Project.Visualizer.Style, Converter={StaticResource EnumBool}, ConverterParameter=GlowingDots}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Fill="{StaticResource CoralBrush}" Height="40" Width="72" Stretch="Uniform" Margin="0,4"
                                                  Data="M4,30 A3,3 0 1 1 4.01,30 Z M14,18 A3,3 0 1 1 14.01,18 Z M24,26 A3,3 0 1 1 24.01,26 Z M34,8 A3,3 0 1 1 34.01,8 Z M44,22 A3,3 0 1 1 44.01,22 Z M54,14 A3,3 0 1 1 54.01,14 Z M64,30 A3,3 0 1 1 64.01,30 Z"/>
                                            <TextBlock Text="Светящиеся точки" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource OptionCard}" GroupName="viz" IsChecked="{Binding Project.Visualizer.Style, Converter={StaticResource EnumBool}, ConverterParameter=SymmetricPulse}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Path Data="M0,20 L6,14 L12,20 L18,6 L24,20 L30,10 L36,20 L42,2 L48,20 L54,12 L60,20 L66,16 L72,20 L66,24 L60,28 L54,20 L48,38 L42,20 L36,30 L30,20 L24,34 L18,20 L12,26 L6,20 Z"
                                                  Fill="#DC143C" Height="40" Width="72" Stretch="Uniform" Margin="0,4"/>
                                            <TextBlock Text="Симметричный пульс" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <TextBlock Text="Цвет" Style="{StaticResource H2}" Margin="0,8,0,10"/>
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource SwatchButton}" Tag="#7868E6" ToolTip="Фиолетовый" Click="VizColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#F17C8A" ToolTip="Коралловый" Click="VizColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#45B8AC" ToolTip="Бирюзовый" Click="VizColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#DC143C" ToolTip="Багровый" Click="VizColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#FFFFFF" ToolTip="Белый" Click="VizColor_Click"/>
                                    <Button Style="{StaticResource SwatchButton}" Tag="#E6B450" ToolTip="Золотой" Click="VizColor_Click"/>
                                    <Button Content="Свой цвет…" Click="VizCustomColor_Click" Margin="4,0,10,8" MinHeight="34" Padding="12,5"/>
                                    <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,8,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2"
                                            Background="{Binding Project.Visualizer.Color, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Text="{Binding Project.Visualizer.Color, UpdateSourceTrigger=LostFocus}" Width="100" Margin="0,0,0,8" ToolTip="Цвет в формате #RRGGBB"/>
                                </WrapPanel>

                                <TextBlock Text="Размер и положение" Style="{StaticResource H2}" Margin="0,8,0,10"/>
                                <v:SliderRow Label="Ширина" Minimum="5" Maximum="100" Step="1" Suffix=" %" Value="{Binding Project.Visualizer.Width}"/>
                                <v:SliderRow Label="Высота" Minimum="3" Maximum="60" Step="1" Suffix=" %" Value="{Binding Project.Visualizer.Height}"/>
                                <v:SliderRow Label="По горизонтали" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Visualizer.X}"/>
                                <v:SliderRow Label="По вертикали" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Visualizer.Y}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Совет: выберите «Эквалайзер» в поле «Перемещать кликом» под предпросмотром и щёлкните или потяните мышью по кадру."/>
                                <v:SliderRow Label="Непрозрачность" Minimum="0.05" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Visualizer.Opacity}"/>
                                <v:SliderRow Label="Свечение" Minimum="0" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Visualizer.Glow}"/>

                                <Expander IsExpanded="False">
                                    <Expander.Header><TextBlock Text="Тонкая настройка" Style="{StaticResource ExpanderHeader}"/></Expander.Header>
                                    <StackPanel Margin="0,12,0,0">
                                        <v:SliderRow Label="Толщина линии" Minimum="1" Maximum="6" Step="0.5" Decimals="1" Value="{Binding Project.Visualizer.Thickness}"/>
                                        <v:SliderRow Label="Чувствительность" Minimum="0.2" Maximum="4" Step="0.1" Decimals="1" Suffix="×" Value="{Binding Project.Visualizer.Sensitivity}"/>
                                        <v:SliderRow Label="Реакция на басы" Minimum="0" Maximum="15" Step="1" Suffix=" дБ" Value="{Binding Project.Visualizer.BassBoost}"/>
                                        <v:SliderRow Label="Плавность" Minimum="0" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Visualizer.Smoothness}"/>
                                        <v:SliderRow Label="Скорость анимации" Minimum="0.25" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Visualizer.Speed}"
                                                     Hint="100 % — мгновенная реакция. Меньше — движение медленнее, с мягким шлейфом."/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ===== ШАГ 4. ОФОРМЛЕНИЕ ===== -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding Step, Converter={StaticResource IntVis}, ConverterParameter=4}">
                            <StackPanel>
                                <TextBlock Text="Настройте оформление" Style="{StaticResource H1}"/>
                                <TextBlock Text="Название, треклист с подсветкой текущей песни, логотип и свой текст." Style="{StaticResource Hint}" Margin="0,4,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Исполнитель" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Project.Overlay.ArtistName, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Название альбома" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding Project.Overlay.AlbumTitle, UpdateSourceTrigger=PropertyChanged, Delay=400}"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid Columns="2" Margin="0,14,0,4">
                                    <CheckBox Content="Название альбома" IsChecked="{Binding Project.Overlay.ShowAlbum}"/>
                                    <CheckBox Content="Имя исполнителя" IsChecked="{Binding Project.Overlay.ShowArtist}"/>
                                    <CheckBox Content="Полный треклист" IsChecked="{Binding Project.Overlay.ShowTracklist}"/>
                                    <CheckBox Content="Номера песен" IsChecked="{Binding Project.Overlay.ShowNumbers}"/>
                                    <CheckBox Content="Название текущей песни" IsChecked="{Binding Project.Overlay.ShowCurrentSong}"/>
                                    <CheckBox Content="Тень у текста" IsChecked="{Binding Project.Overlay.TextShadow}"/>
                                </UniformGrid>

                                <TextBlock Text="Шрифты" Style="{StaticResource H2}" Margin="0,8,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Заголовки" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding TitleFontEntry}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Треклист и подписи" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding BodyFontEntry}" DisplayMemberPath="Name"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Импортировать свой шрифт (TTF / OTF)…" Click="ImportFont_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                                <TextBlock Text="Цвета" Style="{StaticResource H2}" Margin="0,18,0,10"/>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Заголовки" Style="{StaticResource Label}"/>
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Background="{Binding Project.Overlay.TitleColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Grid.Column="2" Text="{Binding Project.Overlay.TitleColor, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,8"/>
                                    <Button Grid.Column="3" Content="Выбрать…" Tag="title" Click="PickTextColor_Click" Margin="0,0,0,8" MinHeight="34" Padding="12,5" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="1" Text="Текст треклиста" Style="{StaticResource Label}"/>
                                    <Border Grid.Row="1" Grid.Column="1" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Background="{Binding Project.Overlay.TextColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Project.Overlay.TextColor, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,8"/>
                                    <Button Grid.Row="1" Grid.Column="3" Content="Выбрать…" Tag="text" Click="PickTextColor_Click" Margin="0,0,0,8" MinHeight="34" Padding="12,5" HorizontalAlignment="Left"/>

                                    <TextBlock Grid.Row="2" Text="Подсветка и исполнитель" Style="{StaticResource Label}"/>
                                    <Border Grid.Row="2" Grid.Column="1" Width="30" Height="30" CornerRadius="15" Margin="0,0,10,8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2" Background="{Binding Project.Overlay.HighlightColor, Converter={StaticResource HexBrush}}"/>
                                    <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Project.Overlay.HighlightColor, UpdateSourceTrigger=LostFocus}" Margin="0,0,10,8"/>
                                    <Button Grid.Row="2" Grid.Column="3" Content="Выбрать…" Tag="hl" Click="PickTextColor_Click" Margin="0,0,0,8" MinHeight="34" Padding="12,5" HorizontalAlignment="Left"/>
                                </Grid>

                                <TextBlock Text="Подсветка текущей песни в треклисте" Style="{StaticResource H2}" Margin="0,12,0,10"/>
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="hl" Content="Смена цвета" IsChecked="{Binding Project.Overlay.Highlight, Converter={StaticResource EnumBool}, ConverterParameter=Color}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="hl" Content="Свечение" IsChecked="{Binding Project.Overlay.Highlight, Converter={StaticResource EnumBool}, ConverterParameter=Glow}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="hl" Content="Подчёркивание" IsChecked="{Binding Project.Overlay.Highlight, Converter={StaticResource EnumBool}, ConverterParameter=Underline}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="hl" Content="Плавное появление" IsChecked="{Binding Project.Overlay.Highlight, Converter={StaticResource EnumBool}, ConverterParameter=Fade}"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="hl" Content="Анимированный маркер" IsChecked="{Binding Project.Overlay.Highlight, Converter={StaticResource EnumBool}, ConverterParameter=Marker}"/>
                                </WrapPanel>

                                <TextBlock Text="Размер текста" Style="{StaticResource H2}" Margin="0,12,0,10"/>
                                <v:SliderRow Label="Название альбома" Minimum="16" Maximum="140" Step="1" Suffix=" px" Value="{Binding Project.Overlay.TitleSize}"/>
                                <v:SliderRow Label="Исполнитель" Minimum="12" Maximum="100" Step="1" Suffix=" px" Value="{Binding Project.Overlay.ArtistSize}"/>
                                <v:SliderRow Label="Треклист" Minimum="12" Maximum="80" Step="1" Suffix=" px" Value="{Binding Project.Overlay.TrackSize}"/>
                                <v:SliderRow Label="Текущая песня" Minimum="12" Maximum="120" Step="1" Suffix=" px" Value="{Binding Project.Overlay.CurrentSize}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Размеры указаны для Full HD и автоматически пересчитываются для 720p, 1440p и 4K."/>

                                <TextBlock Text="Логотип канала" Style="{StaticResource H2}" Margin="0,12,0,10"/>
                                <WrapPanel>
                                    <Button Content="Выбрать PNG-логотип…" Click="ChooseLogo_Click" Margin="0,0,10,8"/>
                                    <Button Content="Убрать" Click="RemoveLogo_Click" Margin="0,0,10,8"/>
                                    <CheckBox Content="Показывать" IsChecked="{Binding Project.Overlay.ShowLogo}" VerticalAlignment="Center" Margin="6,0,0,8"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Project.Overlay.LogoPath}" Style="{StaticResource Hint}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                <v:SliderRow Label="Ширина логотипа" Minimum="1" Maximum="40" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.LogoWidth}"/>
                                <v:SliderRow Label="Непрозрачность" Minimum="0.05" Maximum="1" Step="0.05" Multiplier="100" Suffix=" %" Value="{Binding Project.Overlay.LogoOpacity}"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="Логотип вставляется как есть — программа не изменяет его дизайн, только размер и прозрачность."/>

                                <TextBlock Text="Свой текст" Style="{StaticResource H2}" Margin="0,12,0,10"/>
                                <CheckBox Content="Показывать свой текст" IsChecked="{Binding Project.Overlay.ShowCustomText}"/>
                                <TextBox Text="{Binding Project.Overlay.CustomText, UpdateSourceTrigger=PropertyChanged, Delay=400}" Margin="0,0,0,10"/>
                                <v:SliderRow Label="Размер" Minimum="12" Maximum="120" Step="1" Suffix=" px" Value="{Binding Project.Overlay.CustomSize}"/>

                                <Expander>
                                    <Expander.Header><TextBlock Text="Положение элементов" Style="{StaticResource ExpanderHeader}"/></Expander.Header>
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10" Text="Проще всего: выберите элемент в поле «Перемещать кликом» под предпросмотром и щёлкните по кадру. Значения ниже — для точной подстройки (в % от кадра)."/>
                                        <v:SliderRow Label="Название: X" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.TitleX}"/>
                                        <v:SliderRow Label="Название: Y" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.TitleY}"/>
                                        <v:SliderRow Label="Треклист: X" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.TracklistX}"/>
                                        <v:SliderRow Label="Треклист: Y" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.TracklistY}"/>
                                        <v:SliderRow Label="Ширина колонки" Minimum="10" Maximum="60" Step="1" Suffix=" %" Value="{Binding Project.Overlay.TracklistColumnWidth}"
                                                     Hint="Если песни не помещаются по высоте, треклист автоматически разбивается на колонки"/>
                                        <v:SliderRow Label="Строк в колонке" Minimum="4" Maximum="40" Step="1" Value="{Binding Project.Overlay.MaxRows}"/>
                                        <v:SliderRow Label="Текущая песня: X" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.CurrentX}"/>
                                        <v:SliderRow Label="Текущая песня: Y" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.CurrentY}"/>
                                        <v:SliderRow Label="Логотип: X" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.LogoX}"/>
                                        <v:SliderRow Label="Логотип: Y" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.LogoY}"/>
                                        <v:SliderRow Label="Свой текст: X" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.CustomX}"/>
                                        <v:SliderRow Label="Свой текст: Y" Minimum="0" Maximum="100" Step="0.5" Decimals="1" Suffix=" %" Value="{Binding Project.Overlay.CustomY}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ===== ШАГ 5. СОЗДАНИЕ ВИДЕО ===== -->
                        <StackPanel Visibility="{Binding Step, Converter={StaticResource IntVis}, ConverterParameter=5}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Создайте видео" Style="{StaticResource H1}"/>
                                    <TextBlock Text="MP4 (H.264 + AAC), готовый для загрузки на YouTube." Style="{StaticResource Hint}" Margin="0,4,0,14"/>

                                    <TextBlock Text="Разрешение" Style="{StaticResource H2}"/>
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="res" Content="720p" IsChecked="{Binding Project.Export.Height, Converter={StaticResource IntBool}, ConverterParameter=720}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="res" Content="1080p (Full HD)" IsChecked="{Binding Project.Export.Height, Converter={StaticResource IntBool}, ConverterParameter=1080}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="res" Content="1440p (2K)" IsChecked="{Binding Project.Export.Height, Converter={StaticResource IntBool}, ConverterParameter=1440}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="res" Content="4K (UHD)" IsChecked="{Binding Project.Export.Height, Converter={StaticResource IntBool}, ConverterParameter=2160}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Частота кадров" Style="{StaticResource H2}" Margin="0,8,0,10"/>
                                    <WrapPanel>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fps" Content="24 FPS" IsChecked="{Binding Project.Export.Fps, Converter={StaticResource IntBool}, ConverterParameter=24}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fps" Content="25 FPS" IsChecked="{Binding Project.Export.Fps, Converter={StaticResource IntBool}, ConverterParameter=25}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fps" Content="30 FPS" IsChecked="{Binding Project.Export.Fps, Converter={StaticResource IntBool}, ConverterParameter=30}"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="fps" Content="60 FPS" IsChecked="{Binding Project.Export.Fps, Converter={StaticResource IntBool}, ConverterParameter=60}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Рекомендуется 1080p и 30 FPS: хорошее качество и разумное время создания." Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                                    <Expander>
                                        <Expander.Header><TextBlock Text="Дополнительные параметры" Style="{StaticResource ExpanderHeader}"/></Expander.Header>
                                        <StackPanel Margin="0,12,0,0">
                                            <TextBlock Text="Качество кодирования" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                            <WrapPanel>
                                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="q" Content="Быстро" IsChecked="{Binding Project.Export.Quality, Converter={StaticResource EnumBool}, ConverterParameter=Fast}"/>
                                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="q" Content="Баланс" IsChecked="{Binding Project.Export.Quality, Converter={StaticResource EnumBool}, ConverterParameter=Balanced}"/>
                                                <RadioButton Style="{StaticResource ChipRadio}" GroupName="q" Content="Максимальное качество" IsChecked="{Binding Project.Export.Quality, Converter={StaticResource EnumBool}, ConverterParameter=High}"/>
                                            </WrapPanel>
                                            <CheckBox Content="Использовать видеокарту, если доступна" IsChecked="{Binding Project.Export.UseGpu}" Margin="0,8,0,4"/>
                                            <TextBlock Text="{Binding EncoderInfo}" Style="{StaticResource Hint}" Margin="0,0,0,6"/>
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Text="Куда сохранить" Style="{StaticResource H2}" Margin="0,16,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Project.Export.OutputFolder}" IsReadOnly="True"/>
                                        <Button Grid.Column="1" Content="Выбрать папку…" Click="ChooseOutputFolder_Click" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Имя файла" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Project.Export.FileName, UpdateSourceTrigger=PropertyChanged}"/>

                                    <Border Background="{StaticResource VioletSoftBrush}" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                                        <StackPanel>
                                            <Button Style="{StaticResource PrimaryButton}" Content="Создать тестовое видео — 20 секунд" Click="TestVideo_Click" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left"/>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="Настоящий MP4 с текущей позиции предпросмотра. Проверьте его перед долгим созданием полного видео."/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,16,0,0" Visibility="{Binding LastOutputPath, Converter={StaticResource NotNullVis}}">
                                        <TextBlock Text="Последний готовый файл" Style="{StaticResource Hint}"/>
                                        <TextBlock Text="{Binding LastOutputPath}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                        <WrapPanel>
                                            <Button Content="Открыть видео" Click="OpenLastVideo_Click" Margin="0,0,10,0"/>
                                            <Button Content="Показать в папке" Click="OpenOutputFolder_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Помощник публикации YouTube -->
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Помощник публикации YouTube" Style="{StaticResource H1}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="lang" Content="EN" Margin="0,0,6,0" IsChecked="{Binding Project.YouTube.Language, Converter={StaticResource StrBool}, ConverterParameter=EN}"/>
                                            <RadioButton Style="{StaticResource ChipRadio}" GroupName="lang" Content="RU" Margin="0" IsChecked="{Binding Project.YouTube.Language, Converter={StaticResource StrBool}, ConverterParameter=RU}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,12" Text="Заготовка названия, описания с точными тайм-кодами и хештегов. Всё можно отредактировать. Программа не обещает просмотров или монетизации."/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Сгенерировать заново" Click="GenerateYouTube_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                    <TextBlock Text="Название видео" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding Project.YouTube.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Описание" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Project.YouTube.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="240"
                                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                                    <TextBlock Text="Хештеги" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Project.YouTube.Hashtags, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Ключевые слова (теги)" Style="{StaticResource Hint}" Margin="0,10,0,4"/>
                                    <TextBox Text="{Binding Project.YouTube.Keywords, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Скопировать описание YouTube" Click="CopyDescription_Click" Margin="0,0,10,8"/>
                                        <Button Content="Скопировать тайм-коды" Click="CopyTimestamps_Click" Margin="0,0,10,8"/>
                                        <Button Content="Сохранить TXT" Click="SaveDescription_Click" Margin="0,0,10,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <Grid>
                                    <StackPanel Margin="0,0,220,0">
                                        <TextBlock Text="Обложка для YouTube" Style="{StaticResource H1}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="Простой редактор превью 1280 × 720: фото, текст, логотип, градиент. Сохранение в PNG или JPEG."/>
                                    </StackPanel>
                                    <Button Content="Открыть редактор обложки" Click="OpenThumbnail_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Правая колонка -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="170"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Трек-лист -->
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource TurquoiseBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Style="{StaticResource H1}" FontSize="18">
                                    <Run Text="Трек-лист ("/><Run Text="{Binding Project.Tracks.Count, Mode=OneWay}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource PillButton}" Click="AddTracks_Click" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Добавить треки"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource PillButton}" Click="SortTracks_Click" Margin="0,0,8,0" ToolTip="Сортировать по имени файла" Foreground="{StaticResource Text2Brush}" BorderBrush="{StaticResource BorderBrush}" Background="White">
                                    <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets"/>
                                </Button>
                                <Button Style="{StaticResource PillButton}" Click="ClearTracks_Click" Foreground="{StaticResource Text2Brush}" BorderBrush="{StaticResource BorderBrush}" Background="White">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Очистить"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="TrackList" ItemsSource="{Binding Project.Tracks}" ItemContainerStyle="{StaticResource TrackItemStyle}"
                                 BorderThickness="0" Background="Transparent" AllowDrop="True" Drop="TrackList_Drop" DragOver="TrackList_DragOver"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE784;" FontFamily="Segoe MDL2 Assets" Foreground="#A9B1C0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Cursor="SizeAll" PreviewMouseLeftButtonDown="DragHandle_MouseDown" ToolTip="Перетащите, чтобы изменить порядок" Background="Transparent"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Number, StringFormat={}{0:00}}" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" FontSize="13"/>
                                        <Border Grid.Column="2" Width="30" Height="30" CornerRadius="8" Background="#EAF6F6">
                                            <TextBlock Text="&#xEC4F;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TurquoiseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBox Grid.Column="3" Style="{StaticResource InlineTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, Delay=500}" VerticalAlignment="Center"
                                                 ToolTip="{Binding FilePath}"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource CoralBrush}" Margin="4,0" ToolTip="Файл не найден"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource BoolVis}}"/>
                                            <Border Background="{StaticResource PanelBrush}" CornerRadius="5" Padding="6,1" Margin="4,0">
                                                <TextBlock Text="{Binding Format}" FontSize="11" Foreground="{StaticResource Text2Brush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="5" Text="{Binding DurationText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Margin="0,0,6,0"/>
                                        <StackPanel Grid.Column="6" Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" Tag="{Binding}" Click="PlayTrack_Click" ToolTip="Прослушать"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Tag="{Binding}" Click="MoveUp_Click" ToolTip="Выше"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Tag="{Binding}" Click="MoveDown_Click" ToolTip="Ниже"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Tag="{Binding}" Click="RemoveTrack_Click" ToolTip="Удалить из списка"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="Здесь появятся ваши песни. Перетащите файлы в окно или нажмите «Добавить треки»." Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="30,0" IsHitTestVisible="False"
                                   Visibility="{Binding Project.Tracks.Count, Converter={StaticResource IntVis}, ConverterParameter=0}"/>
                    </Grid>
                </Border>

                <!-- Предпросмотр -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource TurquoiseBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Предпросмотр" Style="{StaticResource H1}" FontSize="18"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="PrevSong_Click" ToolTip="Предыдущая песня" Foreground="{StaticResource TurquoiseBrush}"/>
                                <TextBlock Text="{Binding PreviewTrackLabel}" VerticalAlignment="Center" FontSize="14" Margin="6,0" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="NextSong_Click" ToolTip="Следующая песня" Foreground="{StaticResource TurquoiseBrush}"/>
                            </StackPanel>
                        </Grid>

                        <Border CornerRadius="12" ClipToBounds="True" Background="#1C1A24">
                            <Viewbox Stretch="Uniform">
                                <Grid x:Name="PreviewSurface" Width="1280" Height="720" Background="#1C1A24" Cursor="Cross"
                                      MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <Canvas IsHitTestVisible="False">
                                        <Ellipse x:Name="PlaceMarker" Width="26" Height="26" Stroke="White" StrokeThickness="3" Visibility="Collapsed"/>
                                    </Canvas>
                                    <Border Background="#99000000" CornerRadius="10" Padding="22,12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding PreviewLoading, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Обновляю кадр…" Foreground="White" FontSize="30"/>
                                    </Border>
                                    <TextBlock Text="{Binding PreviewError}" Foreground="#FFB4BE" FontSize="24" TextWrapping="Wrap" Margin="60" VerticalAlignment="Bottom"
                                               Visibility="{Binding PreviewError, Converter={StaticResource NotNullVis}}"/>
                                </Grid>
                            </Viewbox>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Width="38" Height="38" Padding="0" MinHeight="38" Content="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" Click="PlayPause_Click"
                                    Background="#E7F4F5" BorderThickness="0" Foreground="#1F6E7A" ToolTip="Воспроизвести / пауза"/>
                            <TextBlock Grid.Column="1" Text="{Binding PreviewTimeText}" VerticalAlignment="Center" Margin="12,0,8,0" FontSize="13" MinWidth="44"/>
                            <Slider Grid.Column="2" x:Name="PreviewSlider" Minimum="0" Maximum="{Binding PreviewTotal}" Value="{Binding PreviewTime}"
                                    ValueChanged="PreviewSlider_ValueChanged" PreviewMouseLeftButtonUp="PreviewSlider_MouseUp"/>
                            <TextBlock Grid.Column="3" Text="{Binding PreviewTotalText}" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="13"/>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="RefreshPreview_Click" ToolTip="Обновить кадр"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Перемещать кликом:" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource PlaceTargets}}" SelectedItem="{Binding PlaceTarget}" MinHeight="34">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static v:PlaceTargetNames.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Grid.Column="3" Content="Тест 20 сек" Click="TestVideo_Click" IsEnabled="{Binding IsIdle}" MinHeight="34" Padding="14,5"
                                    ToolTip="Создать настоящий 20-секундный MP4 с текущей позиции"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Создать видео -->
                <Button Grid.Row="2" Style="{StaticResource CreateButton}" Margin="0,16,0,0" Click="CreateVideo_Click" IsEnabled="{Binding IsIdle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock Text="Создать видео"/>
                    </StackPanel>
                </Button>

                <!-- Прогресс -->
                <Border Grid.Row="3" Margin="0,12,0,0" Padding="14,10" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding ProgressText}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,110,0"/>
                                <Button Content="Отменить" Click="Cancel_Click" HorizontalAlignment="Right" MinHeight="30" Padding="12,3" Foreground="{StaticResource CoralBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="100"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" Visibility="{Binding IsBusy, Converter={StaticResource InvBoolVis}}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= СТРАНИЦА: ПРОЕКТЫ ================= -->
        <ScrollViewer Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource IntVis}, ConverterParameter=1}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,28" MaxWidth="980">
                <TextBlock Text="Проекты" Style="{StaticResource H1}" FontSize="26"/>
                <TextBlock Text="Проект (.elara) хранит треки, порядок, названия, фон, эквалайзер, оформление, параметры видео и тексты для YouTube. Сами файлы музыки и фона в проект не копируются." Style="{StaticResource Hint}" Margin="0,6,0,20"/>
                <WrapPanel Margin="0,0,0,20">
                    <Button Style="{StaticResource PrimaryButton}" Content="Новый проект" Click="NewProject_Click" Margin="0,0,10,10"/>
                    <Button Content="Открыть проект…" Click="OpenProject_Click" Margin="0,0,10,10"/>
                    <Button Content="Сохранить" Click="SaveProject_Click" Margin="0,0,10,10"/>
                    <Button Content="Сохранить как…" Click="SaveProjectAs_Click" Margin="0,0,10,10"/>
                    <Button Content="Открыть демо-проект" Click="DemoProject_Click" Margin="0,0,10,10" IsEnabled="{Binding IsIdle}"/>
                </WrapPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Недавние проекты" Style="{StaticResource H2}"/>
                        <ListBox ItemsSource="{Binding RecentProjects}" BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick" x:Name="RecentList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,6">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource VioletBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding}" FontSize="14"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Дважды щёлкните по проекту, чтобы открыть его." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= СТРАНИЦА: НАСТРОЙКИ ================= -->
        <ScrollViewer Grid.Row="1" Visibility="{Binding Page, Converter={StaticResource IntVis}, ConverterParameter=2}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,28" MaxWidth="980">
                <TextBlock Text="Настройки" Style="{StaticResource H1}" FontSize="26" Margin="0,0,0,20"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Обработка видео" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding FfmpegInfo}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding EncoderInfo}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Файлы программы" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Кэш хранит собранные альбомы и подготовленные циклы фона, чтобы повторное создание видео шло быстрее. Его можно безопасно очистить."/>
                        <WrapPanel>
                            <Button Content="Открыть папку журналов" Click="OpenLogs_Click" Margin="0,0,10,10"/>
                            <Button Content="Очистить кэш" Click="ClearCache_Click" Margin="0,0,10,10"/>
                            <Button Content="Показать приветствие" Click="ShowWelcome_Click" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="О программе" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Elara Music Builder 4.0 — создание длинных музыкальных видео для YouTube. Использует FFmpeg (лицензия GPL v3), поставляется отдельной программой в папке ffmpeg. Исходный код FFmpeg: https://ffmpeg.org"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
