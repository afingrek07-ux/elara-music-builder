<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ElaraMusicBuilder</RootNamespace>
    <AssemblyName>ElaraMusicBuilder</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.0.0</Version>
    <Product>Elara Music Builder</Product>
    <Company>Elara Music</Company>
    <Copyright>© 2026 Elara Music</Copyright>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\logo256.png" />
    <Resource Include="Assets\logo48.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
